# ClipBlitz configuration — copy to .env and fill in.
# NEVER commit your real .env (it's gitignored).

# --- AI brain (required for the ProX editor; any OpenAI-compatible endpoint) ---
# Groq (free):  https://console.groq.com  → model: openai/gpt-oss-120b
# OpenAI:       https://api.openai.com/v1 → model: gpt-4o-mini
CB_AI_BASE=https://api.groq.com/openai/v1
CB_AI_MODEL=openai/gpt-oss-120b
CB_AI_KEY=replace-me

# --- Gemini failover (optional, free): https://aistudio.google.com/apikey ---
# Every engine call falls back to Gemini when the primary is rate-limited.
# CB_GEMINI_KEY=
# CB_AI_PROVIDER=gemini        # uncomment to make Gemini the primary brain

# --- Speech-to-text ---
# auto = API whisper if CB_AI_KEY is set, else local faster-whisper, else heuristic
CB_STT=auto
CB_STT_MODEL=whisper-large-v3-turbo

# --- Engine ---
CB_PORT=4301
CB_TOP_N=3
CB_PRIVACY=public

# --- YouTube auto-post (optional; see SETUP-YOUTUBE.md for the 4-step wizard) ---
CB_YT_CLIENT_ID=
CB_YT_CLIENT_SECRET=
# CB_YT_REDIRECT=http://localhost:4301/oauth/youtube/callback
