# ClipBlitz configuration — copy to .env and fill in.
# NEVER commit your real .env (it's gitignored).

# --- AI providers (all optional; ARGON runs offline without any) ---
# The app uses an ordered pool and fails over automatically. Put the fastest free
# provider first. Every provider below is OpenAI-compatible.
# Groq (fast free tier): https://console.groq.com
CB_AI_BASE=https://api.groq.com/openai/v1
CB_AI_MODEL=openai/gpt-oss-120b
CB_AI_KEY=replace-me
# More free/paid keys can be comma-separated for rate-limit rotation:
# CB_GROQ_KEYS=key1,key2

# Gemini (free tier): https://aistudio.google.com/apikey
# CB_GEMINI_KEY=
# CB_GEMINI_KEYS=key1,key2

# OpenRouter (has free models): https://openrouter.ai/keys
# CB_OPENROUTER_KEY=
# CB_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Cerebras (fast free tier): https://cloud.cerebras.ai
# CB_CEREBRAS_KEY=
# CB_CEREBRAS_MODEL=llama-3.3-70b

# Together (optional): https://api.together.xyz
# CB_TOGETHER_KEY=
# CB_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# OpenAI (optional): https://platform.openai.com/api-keys
# CB_OPENAI_KEY=
# CB_OPENAI_MODEL=gpt-4o-mini

# No-key free fallback (can be disabled):
# CB_POLLINATIONS=on
# CB_POLLINATIONS_MODEL=openai

# Local, permanent, free: any OpenAI-compatible server. Ollama example:
#   ollama pull qwen2.5:3b
#   ollama serve
# CB_LOCAL_BASE=http://127.0.0.1:11434/v1
# CB_LOCAL_MODEL=qwen2.5:3b

# Provider order. Names: groq, gemini, cerebras, openrouter, together, openai, local
# CB_AI_ORDER=groq,cerebras,gemini,openrouter,local
# CB_EDITOR_WORKERS=3          # parallel editor chunks (default 3)

# --- Speech-to-text ---
# auto = API whisper if CB_AI_KEY is set, else local faster-whisper, else heuristic
CB_STT=auto
CB_STT_MODEL=whisper-large-v3-turbo

# --- Engine ---
CB_PORT=4300
# ARGON is the only engine. Legacy values are accepted for old scripts but map to argon.
CB_ENGINE=argon
CB_TOP_N=3
CB_PRIVACY=public

# --- The daily cycle (optional; on by default, never judges and never publishes) ---
# Once a day it searches your niches, cuts at most CB_DAILY_CUTS of its own top picks,
# runs the ClipBench board and refits. CB_DAILY=off removes it; CB_LAB=0 removes the
# whole lab layer. Nothing it does is a judgment, and nothing it does is a post.
CB_DAILY=on
CB_DAILY_HOUR=9
CB_DAILY_CUTS=1
CB_DAILY_NICHES=podcast clips, gaming fails, cooking shorts, fitness motivation
# CB_DAILY_RESULTS=8
# CB_DAILY_TICK=600

# --- YouTube auto-post (optional; see SETUP-YOUTUBE.md for the 4-step wizard) ---
CB_YT_CLIENT_ID=
CB_YT_CLIENT_SECRET=
# CB_YT_REDIRECT=http://localhost:4300/oauth/youtube/callback
