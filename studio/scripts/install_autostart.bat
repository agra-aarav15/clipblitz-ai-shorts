@echo off
rem ---------------------------------------------------------------------------
rem ClipBlitz Studio - start it with the machine.
rem
rem Writes ONE file into your own Startup folder (no admin, no service, no
rem scheduled task, nothing installed anywhere else):
rem
rem   %APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\ClipBlitz Studio.cmd
rem
rem That file is a per-machine launcher pointing at scripts\boot.bat in whatever
rem folder this studio lives in right now, so the studio itself stays portable.
rem Running this twice is safe: it overwrites the same single file.
rem Remove it again with scripts\uninstall_autostart.bat.
rem ---------------------------------------------------------------------------
setlocal
title ClipBlitz Studio - install autostart

for %%I in ("%~dp0..") do set "STUDIO=%%~fI"
if not exist "%STUDIO%\run.py" (
  echo Could not find run.py above %~dp0 - run this from inside the studio folder.
  pause
  exit /b 1
)

set "STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "LINK=%STARTUP%\ClipBlitz Studio.cmd"
if not exist "%STARTUP%" (
  echo Could not find your Startup folder at:
  echo   %STARTUP%
  pause
  exit /b 1
)

> "%LINK%" echo @echo off
>>"%LINK%" echo rem Generated by ClipBlitz Studio scripts\install_autostart.bat.
>>"%LINK%" echo rem Remove this file, or run scripts\uninstall_autostart.bat, to stop it.
>>"%LINK%" echo call "%STUDIO%\scripts\boot.bat"

echo.
echo Installed:
echo   %LINK%
echo.
echo It calls:
echo   %STUDIO%\scripts\boot.bat
echo.
echo The studio will start minimized at your next sign-in, and its own daily
echo cycle runs from the moment it is up (CB_DAILY=off turns that off).
echo Nothing else on this machine was changed.
echo.
pause
exit /b 0
